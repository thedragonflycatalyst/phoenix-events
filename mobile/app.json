{
  "expo": {
    "name": "Phoenix Community",
    "slug": "phoenix-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "phoenix",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#120e17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.thephoenixcatalyst.community"
    },
    "android": {
      "package": "org.thephoenixcatalyst.community",
      "adaptiveIcon": {
        "backgroundColor": "#120e17",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f4f1f7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#120e17"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Phoenix adds events you're going to into your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7357ee"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Phoenix reads event flyers from your photos.",
          "cameraPermission": "Phoenix uses your camera to snap event flyers.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Phoenix shows events near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Phoenix uses your camera to scan event flyers. Flyers are read on your phone.",
          "recordAudioAndroid": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-community/datetimepicker",
      "./plugins/with-scan-shortcut",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "PhoenixCalendar",
              "label": "Phoenix Calendar",
              "description": "Your month at a glance. Tap a day to see what's on: Google, Outlook and every calendar on your phone, plus Phoenix events.",
              "minWidth": "250dp",
              "minHeight": "280dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://fkksaivdznqbfsfsagsj.supabase.co",
      "supabaseKey": "sb_publishable_ME6Xg1mtUBA4994aC0n6Uw_LKsJDTXu",
      "webUrl": "https://thedragonflycatalyst.github.io/phoenix-events/"
    }
  }
}
